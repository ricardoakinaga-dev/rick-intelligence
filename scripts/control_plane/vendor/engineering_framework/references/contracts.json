    "passing_gate_residual_risk_requiring_confirmed_authority": ["HIGH", "CRITICAL"],
    "required_authority_must_be_confirmed_with_actor_and_evidence": true,
    "not_applicable_requires_rationale_in_limitations": true,
    "prior_gate_decisions_are_append_only_and_reopened_by_new_record": true,
    "criterion_nonempty_fields": ["id", "description", "limitations"],
    "evidence_reference_fields_are_nonempty_strings": true,
    "internal_evidence_references_must_resolve": true,
    "saved_gate_requires_nonempty_revalidation_triggers": true,
    "gates_requiring_typed_verification_evidence": ["VERIFIED", "RELEASE_READY"],
    "open_conditions_require_future_due_at": true,
    "terminal_nonresolution_conditions_remain_blocking": true,
    "terminal_condition_statuses_requiring_evidence": ["SATISFIED", "EXPIRED", "CANCELLED"],
    "confirmed_authority_requires_latest_subject_decision": true,
