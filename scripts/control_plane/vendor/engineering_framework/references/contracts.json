    "pass_forbids_open_conditions": true,
    "pass_with_conditions_requires_open_condition": true,
    "conditions_must_be_non_blocking_for_current_transition": true,
    "open_condition_forbidden_residual_risks": ["UNKNOWN", "HIGH", "CRITICAL"],
