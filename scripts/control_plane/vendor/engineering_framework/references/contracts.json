    "T0_MICRO": {
      "new_persistent_state": false,
      "execplan": false,
      "minimum_review": "SELF",
      "minimum_evidence": ["TARGET_INSPECTION", "FOCUSED_CHECK_OR_DIFF"]
    },
    "T1_SMALL": {
      "new_persistent_state": false,
      "execplan": false,
      "minimum_review": "SELF",
      "minimum_evidence": ["TASK_CONTRACT", "FOCUSED_CHECK", "LOCAL_REGRESSION"]
    },
    "T2_FEATURE": {
      "persistent_state_when_multisession": true,
