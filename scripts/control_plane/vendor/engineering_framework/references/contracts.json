    "pass_evidence_kinds_requiring_zero_exit_status": ["COMMAND"],
    "pass_evidence_kinds_allowing_null_exit_status": ["RUNTIME_OBSERVATION", "MANUAL_OBSERVATION", "STATIC_INSPECTION", "ARTIFACT_INSPECTION", "EXTERNAL_RECORD"],
