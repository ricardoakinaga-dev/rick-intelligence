      "FAIL": ["GATE_FAILED"],
      "BLOCKED": ["GATE_FAILED"],
      "NOT_APPLICABLE": ["GATE_FAILED"]
    },
    "gate_event_results_by_decision": {
      "PENDING": ["PENDING"],
      "PASS": ["PASS"],
      "PASS_WITH_CONDITIONS": ["PASS"],
      "FAIL": ["FAIL"],
      "BLOCKED": ["BLOCKED"],
      "NOT_APPLICABLE": ["NOT_APPLICABLE"]
    },
    "gate_event_must_be_strictly_later": true,
    "legacy_gate_recovery_event_type": "RECOVERY",
