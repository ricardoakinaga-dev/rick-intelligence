# RICK Intelligence root configuration contract.
# Keep secrets empty in this template. Copy to .env locally and fill only the
# values required by the component or app you are intentionally running.

APP_ENV=development
RICK_ENV=local
APP_BASE_URL=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rick_intelligence
POSTGRES_USER=rick
POSTGRES_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6337
QDRANT_COLLECTION=rag_phase0
QDRANT_API_KEY=

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=rick-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Canonical names consumed by the external composition layer. The API factory
# still requires injected clients in production; merely filling these values
# never opens a connection or bypasses that gate.
RICK_EXTERNAL_DATABASE_DSN=
RICK_REDIS_URL=
RICK_QDRANT_URL=http://127.0.0.1:6337
RICK_QDRANT_COLLECTION=rick_dense_v1
RICK_QDRANT_API_KEY=
RICK_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
RICK_OBJECT_STORE_BUCKET=rick-documents
RICK_OBJECT_STORE_REGION=us-east-1
RICK_OBJECT_STORE_ACCESS_KEY_ID=
RICK_OBJECT_STORE_SECRET_ACCESS_KEY=
RICK_OIDC_ISSUER=
RICK_OIDC_AUDIENCE=
RICK_OIDC_JWKS_URL=
RICK_WORKER_ID=rick-worker

# The API reads the process environment; this file is not loaded automatically.
# Local default is explicitly stub (no external provider call).
RICK_API_CHAT_BACKEND=stub
# Set professor + openai-compatible to opt into the external chat path.
# Empty selects deterministic in local/dev/test. Legacy RICK_PROVIDER remains
# accepted; conflicting nonempty canonical/legacy variables fail startup.
LLM_PROVIDER=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Current factory retrieval uses deterministic local embeddings, NOT the LLM.
# These model settings apply to the provider; real retrieval wiring is REC-18.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

RERANKER_PROVIDER=none
RERANKER_MODEL=

SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_MIN=10
CHAT_RATE_LIMIT_PER_MIN=30
RECOVERY_RATE_LIMIT_PER_MIN=5
TRUST_FORWARDED_HEADERS=0
TRUSTED_PROXIES=

# Canonical root API lifecycle limits. Upload staging is private and
# process-local in Phase 1.6; use a durable worker/object store before
# production rollout.
API_MAX_JSON_BYTES=1048576
API_MAX_UPLOAD_BYTES=52428800
INGESTION_MAX_PENDING_JOBS=64
RICK_API_ROOT_KNOWLEDGE=1
RICK_API_ROOT_RETRIEVAL=1
# Optional local durability adapter for the root knowledge catalog. This is a
# restart-recovery fixture, not the production Postgres/object-store path.
RICK_KNOWLEDGE_SQLITE_PATH=
# Optional local-only durable vector read-model; production requires Qdrant.
RICK_VECTOR_SQLITE_PATH=
# Optional local-only bounded audit journal. Production requires an external audit store.
RICK_AUDIT_SQLITE_PATH=
RICK_AUDIT_RETENTION=10000
# Optional local bounded job journal + private staging. Production requires
# an external queue and object store.
RICK_INGESTION_JOURNAL_PATH=
RICK_INGESTION_STAGING_PATH=
RICK_INGESTION_JOURNAL_MAX_ROWS=256

# REC-27 is opt-in twice and remains limited to human case records, reviews,
# and feedback. Keep both flags false until D04 has an approved scope and owner.
RICK_CLINICAL_CASES_ENABLED=false
RICK_CLINICAL_CASES_D04_ENABLED=false
# Optional local restart-safe adapter for the gated case surface. Production
# requires an approved external store and must reject this local path.
RICK_CLINICAL_CASE_SQLITE_PATH=

# Preserved CVG runtime setting (used by the legacy component, not the root
# API upload boundary).
INGESTION_MAX_UPLOAD_BYTES=52428800
INGESTION_MAX_CONCURRENCY=2
INGESTION_PROVIDER_TIMEOUT_SECONDS=30

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25
RETRIEVAL_CONTEXT_BUDGET=12000

OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_REQUEST_ID_HEADER=X-Request-ID
OBSERVABILITY_OTEL_ENDPOINT=

# Ports for preserved legacy processes. Root API canonical key is LLM_API_KEY;
# EXTERNAL_CHAT_API_KEY is a compatibility alias, not a separate credential.
LEGACY_PROFESSOR_PORT=3020
LEGACY_LOCKER_PORT=3317
LEGACY_CVG_API_PORT=8000
LEGACY_CVG_WEB_PORT=3000
