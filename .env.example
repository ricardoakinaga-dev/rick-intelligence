# RICK Intelligence root configuration contract.
# Keep secrets empty in this template. Copy to .env locally and fill only the
# values required by the component or app you are intentionally running.

APP_ENV=development
APP_BASE_URL=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rick_intelligence
POSTGRES_USER=rick
POSTGRES_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6337
QDRANT_COLLECTION=rag_phase0
QDRANT_API_KEY=

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=rick-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

RERANKER_PROVIDER=none
RERANKER_MODEL=

SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_PER_MINUTE=10

INGESTION_MAX_UPLOAD_BYTES=52428800
INGESTION_MAX_CONCURRENCY=2
INGESTION_PROVIDER_TIMEOUT_SECONDS=30

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25
RETRIEVAL_CONTEXT_BUDGET=12000

OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_REQUEST_ID_HEADER=X-Request-ID
OBSERVABILITY_OTEL_ENDPOINT=

# Transitional mapping used only by root orchestration for preserved legacy
# processes. The canonical source is LLM_API_KEY; do not commit a value here.
LEGACY_PROFESSOR_PORT=3020
LEGACY_LOCKER_PORT=3317
LEGACY_CVG_API_PORT=8000
LEGACY_CVG_WEB_PORT=3000
