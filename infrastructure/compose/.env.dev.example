# Copy to an ignored .env file before rendering docker-compose.dev.yml.
# Every value below is disposable local configuration. Never reuse it in
# staging or production and never commit the populated file.
RICK_API_IMAGE=registry.example.invalid/rick/api@sha256:REPLACE_WITH_DEV_DIGEST
RICK_WORKER_IMAGE=registry.example.invalid/rick/worker@sha256:REPLACE_WITH_DEV_DIGEST
RICK_WEB_IMAGE=registry.example.invalid/rick/web@sha256:REPLACE_WITH_DEV_DIGEST
POSTGRES_DB=rick_dev
POSTGRES_USER=rick_dev_runtime
POSTGRES_PASSWORD=REPLACE_WITH_DISPOSABLE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_DISPOSABLE_PASSWORD
QDRANT_API_KEY=REPLACE_WITH_DISPOSABLE_API_KEY
MINIO_ROOT_USER=rick_dev_objects
MINIO_ROOT_PASSWORD=REPLACE_WITH_DISPOSABLE_SECRET
RICK_EXTERNAL_DATABASE_DSN=postgresql://rick_dev_runtime:REPLACE_WITH_DISPOSABLE_PASSWORD@postgres:5432/rick_dev
RICK_REDIS_URL=redis://:REPLACE_WITH_DISPOSABLE_PASSWORD@redis:6379/0
RICK_QDRANT_COLLECTION=rick_dense_v1
RICK_OBJECT_STORE_BUCKET=rick-dev-documents
RICK_OBJECT_STORE_REGION=us-east-1
RICK_LOCKER_BASE_URL=redis://redis:6379
RICK_API_COMPOSITION=deployment_composition:build_api_inputs
RICK_WORKER_COMPOSITION=deployment_composition:build_worker
RICK_OTEL_ENDPOINT=http://otel-collector:4317
LLM_API_KEY=REPLACE_WITH_DISPOSABLE_PROVIDER_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=REPLACE_WITH_REVIEWED_CHAT_MODEL
EMBEDDING_MODEL=text-embedding-3-small
