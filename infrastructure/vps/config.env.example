# Copy outside Git to an absolute path; chmod 600. Literal KEY=value, no shell.
VPS_PROJECT=rick-vps
VPS_DOMAIN=
VPS_ACME_EMAIL=
# All refs: registry/repository@sha256:<64 lowercase hex>; reviewed capabilities.
POSTGRES_IMAGE=
REDIS_IMAGE=
QDRANT_IMAGE=
MINIO_IMAGE=
MC_IMAGE=
CADDY_IMAGE=
# Existing external named volumes only; operator explicitly provisions them.
POSTGRES_VOLUME=rick-vps-postgres
REDIS_VOLUME=rick-vps-redis
QDRANT_VOLUME=rick-vps-qdrant
OBJECT_VOLUME=rick-vps-objects
CADDY_VOLUME=rick-vps-caddy
POSTGRES_DB=rick
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Absolute local files. Store cert SANs: objects.internal, vectors.internal, redis.
TLS_STORE_CERT=
TLS_STORE_KEY=
TLS_STORE_CA=
RICK_ENV=production
RICK_IDENTITY_MODE=production
# User-selected internal RICK accounts; policy validation remains fail-closed.
# This identity choice does not grant image or deployment promotion approval.
RICK_IDENTITY_POLICY=postgres-local-v1
RICK_API_CHAT_BACKEND=professor
RICK_API_COMPOSITION=deployment_composition:build_api_inputs
RICK_WORKER_COMPOSITION=deployment_composition:build_worker
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
RICK_CLINICAL_CASES_ENABLED=false
RICK_CLINICAL_CASES_D04_ENABLED=false
# Percent-encode credentials in URLs. Runtime DSN and separate readonly role.
RICK_EXTERNAL_DATABASE_DSN=
RICK_PREFLIGHT_DATABASE_DSN=
RICK_MIGRATION_DATABASE_DSN=
RICK_REDIS_URL=
RICK_REDIS_REQUIRE_TLS=true
RICK_REDIS_REQUIRE_AUTH=true
RICK_REDIS_VERIFY_TLS=true
RICK_REDIS_TLS_CA_FILE=/tls/ca-bundle.crt
RICK_QDRANT_URL=https://vectors.internal
RICK_QDRANT_COLLECTION=rick_dense_v1
RICK_QDRANT_API_KEY=
RICK_OBJECT_STORE_ENDPOINT=https://objects.internal
RICK_OBJECT_STORE_BUCKET=rick-documents
RICK_OBJECT_STORE_REGION=us-east-1
# Pre-provisioned application user restricted to this bucket; never MinIO root.
RICK_OBJECT_STORE_ACCESS_KEY_ID=
RICK_OBJECT_STORE_SECRET_ACCESS_KEY=
RICK_COMPOSITION_CREATED_BY=
RICK_WORKER_ID=rick-vps-worker
RICK_WORKER_SCOPE_TENANT=
RICK_WORKER_SCOPE_WORKSPACE=
RICK_WORKER_SCOPE_COLLECTION=
# Keep empty for the built-in local identity composition. OIDC is not wired
# by setting URLs; the installer refuses this composition when they are set.
RICK_OIDC_ISSUER=
RICK_OIDC_AUDIENCE=
RICK_OIDC_JWKS_URL=
CORS_ALLOWED_ORIGINS=
# Native canonical provider inputs; explicit model, no baked keys.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
RICK_EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
# Native Anthropic version/token limits when LLM_PROVIDER=anthropic.
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096
