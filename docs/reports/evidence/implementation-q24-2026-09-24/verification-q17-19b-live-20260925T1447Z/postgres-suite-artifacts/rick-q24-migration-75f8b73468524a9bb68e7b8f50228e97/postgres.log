	              AND job_row.lease_owner IS NOT NULL
	              AND job_row.lease_until IS NOT NULL
	              AND job_row.lease_until > COALESCE(job_row.lease_acquired_at, job_row.created_at)
	              AND job_row.lease_until > clock_timestamp() THEN
