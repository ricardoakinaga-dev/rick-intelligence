	            lease_expires := job_row.lease_until;
	        ELSIF job_row.status IN ('failed', 'dead')
	              AND observed_attempts >= effective_max_attempts THEN
	            target_state := 'DEAD_LETTER';
	            target_status := 'dead';
	            observed_attempts := GREATEST(1, observed_attempts);
