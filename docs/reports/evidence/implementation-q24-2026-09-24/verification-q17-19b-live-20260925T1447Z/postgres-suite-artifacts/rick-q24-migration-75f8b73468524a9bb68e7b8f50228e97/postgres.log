	        WHERE j.contract_state IS NULL
	    ) THEN
	        RAISE EXCEPTION
	            'legacy jobs already have attempt rows; reconcile before Phase 2.3 rewrite';
	    END IF;
	
	    IF EXISTS (
	        SELECT 1
