	                                  'index_version', 'job_id', 'lease_id', 'mime_type', 'model_id',
	                                  'object_key', 'operation', 'page', 'provider_id', 'schema_version',
	                                  'section', 'size', 'source_key', 'stage', 'state', 'status',
	                                  'tenant_id', 'trace_id', 'uri', 'url', 'version', 'vector_id',
	                                  'workspace_id'
