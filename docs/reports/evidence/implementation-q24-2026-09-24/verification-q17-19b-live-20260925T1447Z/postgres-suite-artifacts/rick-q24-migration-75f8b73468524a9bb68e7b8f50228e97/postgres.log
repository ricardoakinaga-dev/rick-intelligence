	        INSERT INTO rick_ingestion_job_events
	            (event_id, job_id, tenant_id, workspace_id, collection_id,
	             event_type, from_state, to_state, version, metadata)
	        VALUES (
	            rewrite_event_id,
	            job_row.job_id,
	            job_row.tenant_id,
	            job_row.workspace_id,
	            job_row.collection_id,
	            'legacy_rewritten',
	            NULL,
	            target_state,
	            job_row.version,
	            rewrite_metadata
