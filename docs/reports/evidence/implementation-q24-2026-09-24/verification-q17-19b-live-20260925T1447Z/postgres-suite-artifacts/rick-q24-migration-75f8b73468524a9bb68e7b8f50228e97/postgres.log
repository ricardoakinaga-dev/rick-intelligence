	        ON CONFLICT (event_id) DO NOTHING;
	        INSERT INTO rick_outbox
	            (event_id, tenant_id, aggregate_type, aggregate_id, event_type, payload)
	        VALUES (
	            rewrite_event_id,
	            job_row.tenant_id,
	            'job',
	            job_row.job_id,
	            'jobs.legacy_rewritten',
	            rewrite_metadata
