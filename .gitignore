# Repository metadata
**/.git/

# Secrets and local configuration
.env
.env.*
!.env.example
!**/.env.example
!infrastructure/compose/.env.dev.example
!infrastructure/compose/.env.staging.example
*.pem
*.key
id_rsa*

# Dependencies and generated build output
**/node_modules/
**/.venv/
**/venv/
**/dist/
**/.next/
**/.next-*/
**/coverage/
**/.pytest_cache/
**/.mypy_cache/
**/__pycache__/
**/test-results/
**/.playwright/
**/*.tsbuildinfo
.coverage
**/.coverage

# Local agent orchestration and generated verification evidence
.gauntlet/
.gauntlet-*/
.orchestrate/
.orchestrate-*/
.review-control-history/
artifacts/
.agent/legacy-v1/
.agent/recovery-attempts/

# Runtime data, logs, and local tool state
**/data/
**/src/data/
**/src/logs/*.jsonl
**/src/logs/*.log
**/.claude/
**/.codex/
**/.runtime/
*.log
*.sqlite
*.sqlite3
*.db
*.zip

# Generated release evidence is bound to the checkout at CI time and must not
# become a self-referential tracked artifact.
docs/progress/release-evidence.json

# OS noise
.DS_Store

# Evidence kept by the AUD07-18 policy (docs/reports/evidence/README.md) is
# report proof, not noise: the `*.log` rule above must not hide the 248 kept
# *.log files from `git status`/`git add`.
!docs/reports/evidence/**/*.log

# Local tool state, never an input (AUD07-19): opencode session data and the
# control-plane writer locks. Note that `uv.lock` is deliberately NOT here:
# `apps/api/uv.lock` is named by verification records in `.agent/verification.jsonl`
# (VER-Q24-03-*), so hiding it makes `check_control_plane` fail in a clean checkout.
.opencode/
.agent/*.lock
